/* DeusEx v3 — Tema Fluent Claro (Windows 11) */

* {
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #1E293B;
    outline: none;
}

QMainWindow, QDialog, QWidget#MainRoot, QWidget#MiniChatRoot, QWidget#OnboardingRoot {
    background-color: #F3F5F9;
}

QWidget#Sidebar {
    background-color: #EAEEF5;
    border-right: 1px solid rgba(15, 23, 42, 0.08);
}

QWidget#TopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
}

QLabel#SidebarBrand {
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: 0.4px;
}

QLabel#ViewTitle {
    font-size: 20px;
    font-weight: 600;
    color: #0F172A;
}

QLabel#ViewSubtitle, QLabel#MutedLabel {
    font-size: 12px;
    color: #64748B;
}

QLabel#CardTitle {
    font-size: 14px;
    font-weight: 600;
    color: #0F172A;
}

QLabel#StatusPill {
    background-color: rgba(15, 23, 42, 0.05);
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 11px;
    padding: 4px 10px;
    font-size: 12px;
    color: #334155;
}

QLabel#StatusPill[state="active"] {
    background-color: {{ACCENT_SOFT}};
    border-color: {{ACCENT}};
    color: #0F172A;
    font-weight: 600;
}

QLabel#StatusPill[state="warning"] {
    background-color: rgba(245, 158, 11, 0.16);
    border-color: rgba(217, 119, 6, 0.55);
    color: #92400E;
    font-weight: 600;
}

QLabel#StatusPill[state="danger"] {
    background-color: rgba(239, 68, 68, 0.14);
    border-color: rgba(220, 38, 38, 0.45);
    color: #991B1B;
    font-weight: 600;
}

QFrame#FluentCard, QFrame#SettingRow, QFrame#SettingExpander {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 10px;
}

QFrame#FluentCard:hover, QFrame#SettingRow:hover {
    border-color: rgba(15, 23, 42, 0.16);
}

QFrame#SafetyCard {
    background-color: #FFFBEB;
    border: 1px solid rgba(217, 119, 6, 0.65);
    border-radius: 10px;
}

QFrame#ChatBubble[role="user"] {
    background-color: {{ACCENT_SOFT}};
    border: 1px solid {{ACCENT_BORDER}};
    border-radius: 12px;
}

QFrame#ChatBubble[role="assistant"] {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.09);
    border-radius: 12px;
}

QFrame#ChatBubble[role="system"] {
    background-color: rgba(15, 23, 42, 0.04);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 10px;
}

QFrame#MemoryPill {
    background-color: rgba(16, 185, 129, 0.10);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 10px;
}

QFrame#SidebarFooterCard {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 10px;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 8px;
    padding: 7px 14px;
    min-height: 20px;
    color: #0F172A;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: rgba(15, 23, 42, 0.24);
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: rgba(15, 23, 42, 0.06);
}

QPushButton[variant="primary"] {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
    font-weight: 600;
}

QPushButton[variant="primary"]:hover {
    background-color: {{ACCENT_HOVER}};
    border-color: {{ACCENT_HOVER}};
}

QPushButton[variant="danger"] {
    background-color: #DC2626;
    border-color: #DC2626;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[variant="danger"]:hover {
    background-color: #B91C1C;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: #334155;
}

QPushButton[variant="ghost"]:hover {
    background-color: rgba(15, 23, 42, 0.06);
    color: #0F172A;
}

QPushButton[variant="pill"] {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 14px;
    padding: 5px 12px;
    font-size: 12px;
    color: #334155;
}

QPushButton[variant="pill"]:hover {
    background-color: #F8FAFC;
    color: #0F172A;
}

QPushButton[variant="pill"][selected="true"] {
    background-color: {{ACCENT_SOFT}};
    border-color: {{ACCENT}};
    color: #0F172A;
    font-weight: 600;
}

QPushButton#SidebarNavButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    color: #334155;
    font-weight: 500;
}

QPushButton#SidebarNavButton:hover {
    background-color: rgba(15, 23, 42, 0.06);
    color: #0F172A;
}

QPushButton#SidebarNavButton[active="true"] {
    background-color: #FFFFFF;
    border-left: 3px solid {{ACCENT}};
    color: #0F172A;
    font-weight: 600;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 8px;
    padding: 7px 10px;
    color: #0F172A;
    selection-background-color: {{ACCENT}};
    selection-color: {{ACCENT_TEXT}};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border: 1px solid {{ACCENT}};
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 22px;
    color: #0F172A;
}

QComboBox:hover, QComboBox:focus {
    border-color: {{ACCENT}};
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.16);
    border-radius: 8px;
    selection-background-color: {{ACCENT_SOFT}};
    selection-color: #0F172A;
    padding: 4px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0px;
}

QScrollBar::handle:vertical {
    background: rgba(15, 23, 42, 0.22);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(15, 23, 42, 0.36);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QProgressBar {
    background-color: rgba(15, 23, 42, 0.08);
    border: none;
    border-radius: 4px;
    height: 6px;
}

QProgressBar::chunk {
    background-color: {{ACCENT}};
    border-radius: 4px;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 18px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: {{ACCENT_SOFT}};
    color: #0F172A;
}

QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}
